# Codegen-managed text files must be byte-identical across platforms.
# The package's _data/manifest.json carries SHA-256 sums; on Windows
# without this rule, autocrlf=true would commit CRLF and POSIX
# checkouts would see LF, breaking every SHA in the manifest.
#
# Mirrors docs/antikythera-maths/antikythera-spectral/.gitattributes
# at the same discipline. Force LF on every codegen-emitted text
# file in the ephemerides-spectral subtree.

python/ephemerides_spectral/_data/*.json    text eol=lf
python/ephemerides_spectral/_research/*.py  text eol=lf
python/ephemerides_spectral/_research/*.md  text eol=lf
python/ephemerides_spectral/_data/manifest.json text eol=lf

# CHANGELOG / README / ROADMAP / pyproject — LF on every platform for
# diff stability (PyPI renders these regardless of EOL style).
README.md             text eol=lf
CHANGELOG.md          text eol=lf
ROADMAP.md            text eol=lf
python/README.md      text eol=lf
python/CHANGELOG.md   text eol=lf
python/pyproject.toml text eol=lf

# Python sources — LF on every platform.
python/ephemerides_spectral/*.py text eol=lf
python/tests/*.py     text eol=lf
codegen/*.py          text eol=lf
bridge/*.py           text eol=lf

# C port — LF for the source/header/Makefile, the manifest, the .pages.
c/include/*.h         text eol=lf
c/src/*.c             text eol=lf
c/test/*.c            text eol=lf
c/test/*.py           text eol=lf
c/codegen/*.py        text eol=lf
c/manifest.json       text eol=lf
c/Makefile            text eol=lf
c/README.md           text eol=lf
c/.gitignore          text eol=lf
