{"anomaly_id": "cold-spot", "row_type": "anomaly_feature", "canonical_name": "Cold Spot", "anomaly_kind": "hotspot", "ell_range_min": 10, "ell_range_max": 100, "statistical_significance_sigma": 3.0, "statistical_test": "Spherical Mexican Hat Wavelet (SMHW) coefficient at ~5-10° scale, vs. simulated ΛCDM ensemble; also test of non-Gaussianity by skewness / kurtosis of wavelet coefficients.", "sky_location_galactic_lon_deg": 210.0, "sky_location_galactic_lat_deg": -57.0, "principal_reference_doi": "10.1086/421007", "principal_reference_label": "Vielva et al. 2004 ApJ 609:22-34", "confirmation_reference_dois": ["10.1111/j.1365-2966.2004.08419.x", "10.1086/509703", "10.1051/0004-6361/201833881"], "precision_flag": "test_dependent", "notes": "Localized cold region at galactic (l, b) ≈ (210°, -57°), ~10° diameter, ~70 μK below mean. Discovered in WMAP 1-year data; re-confirmed Planck 2018 PR3. Possible explanations include cosmic supervoid (Szapudi et al. 2015) and Sunyaev-Zel'dovich integrated effect; no consensus on interpretation.", "source_doi": "10.1051/0004-6361/201833881", "source_published_date": "2020-09-11", "entered_locally_at": "2026-05-12", "source_version": "PR3"}
{"anomaly_id": "hemispherical-power-asymmetry", "row_type": "anomaly_feature", "canonical_name": "Hemispherical Power Asymmetry (Dipolar Modulation)", "anomaly_kind": "asymmetry", "ell_range_min": 2, "ell_range_max": 600, "statistical_significance_sigma": 3.0, "statistical_test": "Local-variance analysis of CMB temperature in hemispheres oriented along a preferred direction; equivalently, dipolar-modulation amplitude A in the model T(n̂) = T₀(1 + A·n̂·d̂), vs. ΛCDM isotropic-Gaussian null.", "sky_location_galactic_lon_deg": 237.0, "sky_location_galactic_lat_deg": -20.0, "principal_reference_doi": "10.1086/382267", "principal_reference_label": "Eriksen et al. 2004 ApJ 605:14-20", "confirmation_reference_dois": ["10.1088/0004-637X/704/2/1448", "10.1051/0004-6361/201833881"], "precision_flag": "test_dependent", "notes": "Power difference between hemispheres oriented along (l, b) ≈ (237°, -20°). Strongest at ℓ ≤ 64; persists to ℓ ≈ 600. Distinct from but possibly related to Axis of Evil; multiple low-ℓ anomalies share preferred directions ('low-ℓ axis' family).", "source_doi": "10.1051/0004-6361/201833881", "source_published_date": "2020-09-11", "entered_locally_at": "2026-05-12", "source_version": "PR3"}
{"anomaly_id": "low-quadrupole", "row_type": "anomaly_feature", "canonical_name": "Low Quadrupole (C₂ Anomaly)", "anomaly_kind": "suppression", "ell_range_min": 2, "ell_range_max": 2, "statistical_significance_sigma": 2.0, "statistical_test": "Observed C₂ vs. ΛCDM best-fit C₂; equivalently the cumulative-distribution-function p-value of C₂_obs in the ΛCDM-predicted distribution including cosmic variance.", "sky_location_galactic_lon_deg": null, "sky_location_galactic_lat_deg": null, "principal_reference_doi": "10.1086/310077", "principal_reference_label": "Hinshaw et al. 1996 ApJ 464:L25-L28 (COBE)", "confirmation_reference_dois": ["10.1051/0004-6361/201833881"], "precision_flag": "test_dependent", "notes": "Observed D_ℓ=2 ≈ 230 μK² vs. ΛCDM expectation ~1100 μK² (factor ~5 deficit). Significance modest on its own (cosmic variance is large at ℓ=2: σ/μ ≈ 0.63), but contributes to the broader low-ℓ deficit / correlation anomaly family. First flagged in COBE (1992); reinforced in WMAP and Planck.", "source_doi": "10.1051/0004-6361/201833881", "source_published_date": "2020-09-11", "entered_locally_at": "2026-05-12", "source_version": "PR3"}
{"anomaly_id": "parity-asymmetry-low-ell", "row_type": "anomaly_feature", "canonical_name": "Low-ℓ Parity Asymmetry", "anomaly_kind": "parity_violation", "ell_range_min": 2, "ell_range_max": 30, "statistical_significance_sigma": 2.5, "statistical_test": "Ratio of summed power at odd ℓ vs. even ℓ over the low-ℓ regime: R(ℓ_max) = Σ_{odd ℓ≤ℓ_max} D_ℓ / Σ_{even ℓ≤ℓ_max} D_ℓ, vs. ΛCDM-predicted ratio distribution.", "sky_location_galactic_lon_deg": null, "sky_location_galactic_lat_deg": null, "principal_reference_doi": "10.1103/PhysRevD.72.101302", "principal_reference_label": "Land & Magueijo 2005 Phys. Rev. D 72:101302", "confirmation_reference_dois": ["10.1088/2041-8205/714/2/L265", "10.1051/0004-6361/201833881"], "precision_flag": "test_dependent", "notes": "Excess of odd-ℓ power vs. even-ℓ power at low multipoles (ℓ ≤ 30). 'Universe is odd' framing of Land & Magueijo 2005. Distinct from Axis of Evil but in same low-ℓ-deficit anomaly family.", "source_doi": "10.1051/0004-6361/201833881", "source_published_date": "2020-09-11", "entered_locally_at": "2026-05-12", "source_version": "PR3"}
{"anomaly_id": "missing-large-angle-correlation", "row_type": "anomaly_feature", "canonical_name": "Missing Large-Angle Correlation (S 1/2 Anomaly)", "anomaly_kind": "correlation_anomaly", "ell_range_min": 2, "ell_range_max": 30, "statistical_significance_sigma": 3.0, "statistical_test": "S 1/2 statistic = ∫_{-1}^{1/2} [C(cos θ)]² d(cos θ) — the integrated squared two-point correlation function over angles θ > 60°, vs. ΛCDM-simulated ensemble.", "sky_location_galactic_lon_deg": null, "sky_location_galactic_lat_deg": null, "principal_reference_doi": "10.1086/310077", "principal_reference_label": "Hinshaw et al. 1996 ApJ 464:L25-L28 (first noted) / Spergel et al. 2003 ApJS 148:175 (WMAP)", "confirmation_reference_dois": ["10.1111/j.1365-2966.2005.09980.x", "10.1051/0004-6361/201833881"], "precision_flag": "test_dependent", "notes": "Two-point correlation C(θ) is anomalously suppressed at large angles (θ > 60°). Reported p-values vary from ~0.03% (Copi et al. 2007 sky-cut analysis) to ~0.7% (Planck 2018 VII full-sky analysis) depending on mask + estimator. Strongly linked to the low-quadrupole / parity anomalies via low-ℓ-deficit common cause.", "source_doi": "10.1051/0004-6361/201833881", "source_published_date": "2020-09-11", "entered_locally_at": "2026-05-12", "source_version": "PR3"}
